# STAGING ONLY — never put real production credentials here.
# The application currently accepts NODE_ENV=development|test|production;
# APP_ENV is the explicit staging environment flag.
NODE_ENV=production
APP_ENV=staging
APP_NAME=rewzio-staging
POSTGRES_PASSWORD=replace-with-staging-only-password
JWT_ACCESS_SECRET=replace-with-a-random-staging-secret-at-least-32-chars
OTP_SECRET=replace-with-a-random-staging-secret-at-least-32-chars
GOOGLE_CLIENT_ID=staging-client.apps.googleusercontent.com
CORS_ORIGIN=https://api.servicebusiness.eu.org
PAYOUT_MODE=MOCK
IS_DEMO=true
SOCIAL_PROOF_IS_DEMO=true

# The staging compose file supplies these service-local URLs.
# DATABASE_URL=postgresql://rewzio_staging:<password>@postgres:5432/rewzio_staging
# REDIS_URL=redis://redis:6379
