# STAGING ONLY — never put real production credentials here.
NODE_ENV=staging
APP_ENV=staging
APP_NAME=rewzio-staging
POSTGRES_PASSWORD=replace-with-staging-only-password
JWT_ACCESS_SECRET=replace-with-staging-only-secret
OTP_SECRET=replace-with-staging-only-secret
PAYOUT_MODE=MOCK
IS_DEMO=true
SOCIAL_PROOF_IS_DEMO=true

# The staging compose file supplies these service-local URLs.
# DATABASE_URL=postgresql://rewzio_staging:<password>@postgres:5432/rewzio_staging
# REDIS_URL=redis://redis:6379
