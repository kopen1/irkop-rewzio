generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Coins are BIGINT. IDR monetary values are NUMERIC(20,2).
// coin_ledger is immutable by application design; corrections use compensating entries.

enum AppStatus {
  ACTIVE
  INACTIVE
  MAINTENANCE
}

enum Environment {
  LOCAL
  STAGING
  PRODUCTION
}

enum FeatureMode {
  GLOBAL
  APP
  FEATURE
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETION_REQUESTED
  DELETION_PENDING
  ANONYMIZED
  DELETED
}

enum UserAppStatus {
  ACTIVE
  SUSPENDED
}

enum IntegrityStatus {
  VERIFIED
  UNVERIFIED
  UNSUPPORTED
  FAILED
  UNKNOWN
}

enum DeviceStatus {
  ACTIVE
  BLOCKED
  SUSPENDED
}

enum SessionStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum OtpStatus {
  PENDING
  VERIFIED
  EXPIRED
  LOCKED
}

enum LedgerStatus {
  PENDING
  CONFIRMED
  REVERSED
  VOID
}

enum ConfigStatus {
  ACTIVE
  INACTIVE
}

enum RewardStatus {
  PENDING
  CONFIRMED
  REJECTED
  REVERSED
}

enum ContentStatus {
  ACTIVE
  INACTIVE
  DRAFT
  EXPIRED
}

enum WatchStatus {
  STARTED
  IN_PROGRESS
  COMPLETED
  REJECTED
  EXPIRED
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  REWARDED
  REJECTED
}

enum WithdrawalStatus {
  PENDING_REVIEW
  APPROVED
  PROCESSING
  PENDING_PROVIDER
  COMPLETED
  FAILED
  REJECTED
  CANCELLED
  REFUNDED
  PENDING_CAPACITY
}

enum WithdrawalMethodType {
  DANA
  OVO
  GOPAY
  SHOPEEPAY
  BANK
}

enum MethodStatus {
  ACTIVE
  INACTIVE
  VERIFIED
  BLOCKED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum ProviderStatus {
  ACTIVE
  INACTIVE
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
  IGNORED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum HoldStatus {
  HELD
  RELEASED
  CONSUMED
}

enum SecurityActionStatus {
  PENDING
  APPLIED
  REVERSED
}

enum NotificationType {
  REWARD_RECEIVED
  WITHDRAWAL_SUBMITTED
  WITHDRAWAL_PROCESSING
  WITHDRAWAL_COMPLETED
  WITHDRAWAL_FAILED
  SYSTEM_ANNOUNCEMENT
  MAINTENANCE
}

enum NotificationChannel {
  PUSH
  IN_APP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  READ
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_USER
  WAITING_PROVIDER
  RESOLVED
  CLOSED
}

enum SupportPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum DeletionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum AdminStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

model Apps {
  id String @id @default(uuid())
  name String
  slug String
  packageName String
  status AppStatus
  environment Environment
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([slug])
  @@unique([packageName])
  @@index([status])
  @@map("apps")
}

model AppSettings {
  id String @id @default(uuid())
  appId String
  key String
  value Json
  version Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([appId, id])
  @@unique([appId, key])
  @@index([appId])
  @@map("app_settings")
}

model FeatureFlags {
  id String @id @default(uuid())
  appId String
  key String
  enabled Boolean
  mode FeatureMode
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([appId, id])
  @@unique([appId, key])
  @@index([appId])
  @@map("feature_flags")
}

model Users {
  id String @id @default(uuid())
  phone String?
  phoneVerifiedAt DateTime?
  googleSubject String?
  status UserStatus
  referralCode String
  lastLoginAt DateTime?
